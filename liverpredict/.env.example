# LiverPredict AI — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Flask
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=change-me-to-a-long-random-string

# Database (SQLite default — no setup needed)
# For MySQL: DATABASE_URL=mysql+pymysql://user:password@localhost:3306/liver_predict
# DATABASE_URL=

# Admin credentials (set before first run)
ADMIN_EMAIL=admin@liverpredict.ai
ADMIN_PASSWORD=Admin@12345

# Email (optional — for password reset emails)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_SUPPRESS_SEND=0
